# 项目级大模型参数配置模板
#
# 用法：复制为仓库根目录的 `.env` 后填入真实值：
#   cp .env.example .env
# `.env` 已被 `.gitignore` 忽略，不会提交到仓库。
# 注意：代码只读 `.env` 文件，不读环境变量。

# 模型服务地址（OpenAI 兼容网关）
CONFIG_AGENT_MODEL_BASE_URL=http://10.184.131.15/gpu_gateway/deepseek_v4_flash/v1

# 模型 API Key（敏感值，仅存在于本地 .env）
CONFIG_AGENT_MODEL_API_KEY=

# 模型名称。DeepSeek 常用：deepseek-chat（通用对话）/ deepseek-reasoner（推理增强）
CONFIG_AGENT_MODEL_NAME=deepseek_v4_flash

# 单次模型调用超时，正整数加 ms/s/m/h 单位
CONFIG_AGENT_MODEL_TIMEOUT=30s
